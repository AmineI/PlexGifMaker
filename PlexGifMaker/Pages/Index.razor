@page "/"
@page "/index"
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@using PlexGifMaker.Data
@using PlexGifMaker.Pages.Components
@using SubtitlesParser.Classes
@inject NavigationManager NavigationManager
@inject ProtectedLocalStorage ProtectedLocalStorage
@inject PlexService PlexService
@inject ILogger<Index> _logger

@namespace PlexGifMaker.Data

<h3>Select Library, TV Show, Episode, and Subtitle Segment</h3>

@if (!string.IsNullOrEmpty(errorMessage))
{
    <div class="alert alert-danger">@errorMessage</div>
}

@if (!string.IsNullOrEmpty(successMessage))
{
    <div class="alert alert-success">@successMessage</div>
}

@if (isLoading)
{
    <LoadingSpinner />
}
else
{
    <div class="mb-3">
        <button class="btn btn-success" @onclick="AutoDetectCurrentlyPlaying" disabled="@isAutoDetecting">
            @if (isAutoDetecting)
            {
                <span class="spinner-border spinner-border-sm" role="status" aria-hidden="true"></span>
                <span> Detecting...</span>
            }
            else
            {
                <span>🎬 Auto-Detect Currently Playing</span>
            }
        </button>
    </div>

    <LibrarySelector Libraries="libraries" SelectedValue="@selectedLibraryKey" OnLibrarySelected="@HandleLibraryChange" />

    @if (shows != null && shows.Any())
    {
        <ShowSelector Shows="shows" SelectedValue="@selectedShowKey" OnShowSelected="@HandleShowChange" />
    }

    @if (episodes != null && episodes.Any())
    {
        <EpisodeSelector Episodes="episodes" SelectedValue="@selectedEpisode" OnEpisodeSelected="@HandleEpisodeChange" />
    }

    @if (subtitleOptions != null && subtitleOptions.Any())
    {
        <SubtitleSelector SubtitleOptions="subtitleOptions" SelectedValue="@selectedSubtitleOptionKey" OnSubtitleSelected="@HandleSubtitleOptionChange" />
    }

    @if (!string.IsNullOrEmpty(selectedEpisode) || !subsFound)
    {
        <GifCreator SelectedEpisode="selectedEpisode"
                    Subtitles="subtitles"
                    TotalDuration="totalDuration"
                    OnCreateGif="CreateGif"
                    IsCreatingGif="isCreatingGif"
                    IsExtracting="isExtracting"
                    GifPath="@gifPath"
                    @ref="gifCreatorRef" />
    }
}

    @code {
        private string? selectedLibraryKey;
        private string? selectedShowKey;
        private string? selectedEpisode;
        private string? selectedSubtitleOptionKey;
        private List<Library>? libraries;
        private List<Episode>? shows;
        private List<Episode>? episodes;
        private bool isLoading = true;
        private List<SubtitleItem>? subtitles;
        private string? gifPath;
        private bool isCreatingGif = false;
        private bool isExtracting = false;
        private string? errorMessage;
        private string? successMessage;
        private TimeSpan totalDuration;
        private bool subsFound = true;
        private List<Subtitle?>? subtitleOptions;
        private bool isAutoDetecting = false;

        private GifCreator? gifCreatorRef;

   private async Task CreateGif((int startTime, int endTime, string format) times)
{
    if (string.IsNullOrEmpty(selectedEpisode))
    {
        errorMessage = "Please select all the necessary options before creating a GIF.";
        StateHasChanged();
        return;
    }

    isCreatingGif = true;
    errorMessage = null;
    gifPath = null;
    StateHasChanged();

    try
    {
        string? newGifPath;
        var selectedSubtitle = subtitleOptions?.FirstOrDefault(sub => sub?.Key == selectedSubtitleOptionKey);
        if (selectedSubtitleOptionKey != null && selectedSubtitle != null)
        {
            newGifPath = await PlexService.CreateGifFromSubtitlesAsync(selectedEpisode, times.startTime, times.endTime, times.format, selectedSubtitle);
        }
        else
        {
            newGifPath = await PlexService.CreateGifFromSubtitlesAsync(selectedEpisode, times.startTime, times.endTime, times.format);
        }

        if (!string.IsNullOrEmpty(newGifPath))
        {
            // Remove "/wwwroot/" prefix if it exists
            newGifPath = newGifPath.Replace("wwwroot/", "");
            _logger.LogInformation($"Modified GIF Path: {newGifPath}");

            // Ensure the gifPath starts with a forward slash
            gifPath = newGifPath.StartsWith("/") ? newGifPath : "/" + newGifPath;
            _logger.LogInformation($"Final Clip Path for display: {gifPath}");
        }
        else
        {
            errorMessage = "Failed to generate Clip. The service returned an empty path.";
            _logger.LogWarning("Clip creation failed. Empty path returned from service.");
        }
    }
    catch (Exception ex)
    {
        _logger.LogError(ex, "Error creating Clip");
        errorMessage = "An error occurred while creating the Clip. Please try again.";
        gifPath = null;
    }
    finally
    {
        isCreatingGif = false;
        StateHasChanged();
    }
}


        protected override async Task OnAfterRenderAsync(bool firstRender)
        {
            if (firstRender)
            {
                await InitializeSettingsAndLibraries();
            }
        }

        private async Task InitializeSettingsAndLibraries()
        {
            var baseUriResult = await ProtectedLocalStorage.GetAsync<string>("PlexBaseUri");
            var tokenResult = await ProtectedLocalStorage.GetAsync<string>("PlexToken");

            if (!baseUriResult.Success || string.IsNullOrWhiteSpace(baseUriResult.Value) ||
                !tokenResult.Success || string.IsNullOrWhiteSpace(tokenResult.Value))
            {
                _logger.LogWarning("Base URI or token is missing in local storage. Redirecting to settings.");
                NavigationManager.NavigateTo("/settings");
                return;
            }

            PlexService.SetConfiguration(baseUriResult.Value!, tokenResult.Value!);

            try
            {
                libraries = await PlexService.GetLibrariesAsync();
            }
            catch (UnauthorizedAccessException)
            {
                errorMessage = "Your Plex session may have expired or you may not have the necessary permissions. Please try re-authenticating.";
                NavigationManager.NavigateTo("/settings");
                return;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Failed to fetch libraries");
                errorMessage = "An error occurred while fetching your Plex libraries. Please try again later.";
            }
            finally
            {
                isLoading = false;
                StateHasChanged();
            }
        }

        private async Task HandleLibraryChange(string libraryKey)
        {
            selectedLibraryKey = libraryKey ?? string.Empty;
            try
            {
                var content = await PlexService.GetShowsAsync(selectedLibraryKey);
                if (content == null || !content.Any())
                {
                    _logger.LogWarning("No content found in library {LibraryKey}", selectedLibraryKey);
                    shows = new List<Episode>();
                    episodes = new List<Episode>();
                }
                else
                {
                    // Check if the library contains movies
                    if (content.Any(item => item.IsMovie))
                    {
                        // This is a movie library
                        episodes = content.Where(item => item.IsMovie).ToList();
                        shows = null; // Set shows to null for movie libraries
                    }
                    else
                    {
                        // This is a TV show library
                        shows = content.Where(item => !item.IsMovie).ToList();
                        episodes = null; // Set episodes to null for TV show libraries
                    }
                }

                selectedEpisode = null;
                selectedShowKey = null;
                selectedSubtitleOptionKey = null;
                subtitles = null;
                subtitleOptions = null;
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error fetching content for library {LibraryKey}", selectedLibraryKey);
                errorMessage = "An error occurred while fetching content. Please try again.";
            }
            StateHasChanged();
        }

        private async Task HandleShowChange(string showKey)
        {
            selectedShowKey = showKey;
            if (!string.IsNullOrWhiteSpace(selectedShowKey))
            {
                try
                {
                    episodes = await PlexService.GetEpisodesAsync(selectedShowKey, false);
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Error fetching episodes for show {ShowKey}", selectedShowKey);
                    errorMessage = "An error occurred while fetching episodes. Please try again.";
                }
            }
            else
            {
                _logger.LogWarning("selectedShowKey is null or whitespace.");
            }
            selectedEpisode = null;
            subtitles = null;
            subtitleOptions = null;
            selectedSubtitleOptionKey = null;
            StateHasChanged();
        }

        private async Task HandleEpisodeChange(string episodeId)
        {
            selectedEpisode = episodeId;
            subtitles = null;
            selectedSubtitleOptionKey = null;
            subtitleOptions = null;
            if (selectedEpisode != null)
            {
                try
                {
                    subtitleOptions = await PlexService.GetSubtitleOptionsAsync(selectedEpisode);
                    totalDuration = await PlexService.GetEpisodeDurationAsync(selectedEpisode);

                    if (subtitleOptions == null || !subtitleOptions.Any())
                    {
                        subsFound = false;
                        errorMessage = "No subtitles found for the selected episode. Please enter the start and end times manually.";
                    }
                    else
                    {
                        subsFound = true;
                        errorMessage = null;
                    }
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Error fetching subtitle options for content {ContentId}", selectedEpisode);
                    errorMessage = "An error occurred while fetching subtitle options. Please try again.";
                }
            }
            else
            {
                _logger.LogWarning("Selected content is null or empty.");
            }
            StateHasChanged();
        }

        private async Task HandleSubtitleOptionChange(string subtitleKey)
        {
            if (!string.IsNullOrEmpty(subtitleKey))
            {
                if (int.TryParse(subtitleKey, out var index))
                {
                    selectedSubtitleOptionKey = index.ToString();
                }
                else
                {
                    selectedSubtitleOptionKey = subtitleKey;
                }
                await setSubtitles();
            }
            else
            {
                _logger.LogWarning("OnSubtitleOptionChange received a null or empty value.");
            }
        }



        private async Task setSubtitles()
        {
            if (!string.IsNullOrEmpty(selectedEpisode))
            {
                try
                {
                    await PlexService.DeleteSubtitleFilesAsync();
                    var chosenSubtitleOption = subtitleOptions?.FirstOrDefault(sub => sub?.Key == selectedSubtitleOptionKey);
                    if (chosenSubtitleOption != null)
                    {
                        if (int.TryParse(selectedSubtitleOptionKey, out int index))
                        {
                            isExtracting = true;
                            StateHasChanged();
                            subtitles = await PlexService.ExtractSubtitles(selectedEpisode, chosenSubtitleOption);
                        }
                        else
                        {
                            subtitles = await PlexService.GetActualSubtitlesAsync(selectedEpisode, chosenSubtitleOption);
                        }
                    }

                    totalDuration = await PlexService.GetEpisodeDurationAsync(selectedEpisode);

                    _logger.LogInformation($"Fetched {subtitles?.Count} subtitles for episode {selectedEpisode}");
                    if (subtitles?.Count == 0)
                    {
                        subsFound = false;
                        errorMessage = "No subtitles found for the selected episode. Please enter the start and end times manually.";
                    }
                    else
                    {
                        subsFound = true;
                        errorMessage = null;
                    }
                }
                catch (Exception ex)
                {
                    _logger.LogError(ex, "Error fetching subtitles for episode {EpisodeId}", selectedEpisode);
                    errorMessage = "An error occurred while fetching subtitles. Please try again.";
                }
                finally
                {
                    isExtracting = false;
                    StateHasChanged();
                }
            }
            else
            {
                _logger.LogWarning("Selected episode is null or empty.");
                errorMessage = "Please select an episode before fetching subtitles.";
            }
        }

        private async Task AutoDetectCurrentlyPlaying()
        {
            isAutoDetecting = true;
            errorMessage = null;
            successMessage = null;
            StateHasChanged();

            try
            {
                var currentlyPlaying = await PlexService.GetCurrentlyPlayingMediaAsync();

                if (currentlyPlaying == null)
                {
                    errorMessage = "No media is currently playing on your Plex server.";
                    _logger.LogInformation("No currently playing media detected.");
                    return;
                }

                _logger.LogInformation("Detected currently playing media: {Title} (ID: {Id})", 
                    currentlyPlaying.EpisodeTitle, currentlyPlaying.EpisodeId);

                // Set the library
                if (!string.IsNullOrEmpty(currentlyPlaying.LibraryId))
                {
                    selectedLibraryKey = currentlyPlaying.LibraryId;
                    await HandleLibraryChange(selectedLibraryKey);
                }

                // For TV shows, set the show
                if (!string.IsNullOrEmpty(currentlyPlaying.ShowId) && currentlyPlaying.MediaType == "episode")
                {
                    selectedShowKey = currentlyPlaying.ShowId;
                    await HandleShowChange(selectedShowKey);
                }

                // Set the episode
                if (!string.IsNullOrEmpty(currentlyPlaying.EpisodeId))
                {
                    selectedEpisode = currentlyPlaying.EpisodeId;
                    await HandleEpisodeChange(selectedEpisode);
                }

                // Match the Plex-selected subtitle stream to the loaded subtitle options
                if (currentlyPlaying.CurrentSubtitle != null && subtitleOptions != null && subtitleOptions.Any())
                {
                    var matchedSubtitle = subtitleOptions.FirstOrDefault(s =>
                        s != null &&
                        ((!string.IsNullOrEmpty(s.Id) && s.Id == currentlyPlaying.CurrentSubtitle.Id) ||
                         (!string.IsNullOrEmpty(s.Key) && s.Key == currentlyPlaying.CurrentSubtitle.Key) ||
                         (s.Language == currentlyPlaying.CurrentSubtitle.Language && s.DisplayTitle == currentlyPlaying.CurrentSubtitle.DisplayTitle)));

                    if (matchedSubtitle?.Key != null)
                    {
                        selectedSubtitleOptionKey = matchedSubtitle.Key;
                        _logger.LogInformation("Auto-selecting subtitle stream: {DisplayTitle} (Key: {Key})",
                            matchedSubtitle.DisplayTitle, matchedSubtitle.Key);
                        await HandleSubtitleOptionChange(matchedSubtitle.Key);
                    }
                }

                // Set the subtitle times based on current playback position
                if (currentlyPlaying.ViewOffset > 0)
                {
                    await Task.Delay(100);
                    if (gifCreatorRef == null)
                    {
                        _logger.LogWarning("Unable to autofill subtitle times because the GIF creator is not rendered.");
                    }
                    else
                    {
                    int startTime = Math.Max(0, currentlyPlaying.ViewOffset - 10000);
                    int endTime = currentlyPlaying.ViewOffset;

                    var activeSubtitle = subtitles?.FirstOrDefault(s =>
                        s.StartTime <= currentlyPlaying.ViewOffset && s.EndTime >= currentlyPlaying.ViewOffset)
                        ?? subtitles?.OrderBy(s => Math.Abs(s.StartTime - currentlyPlaying.ViewOffset)).FirstOrDefault();

                    if (activeSubtitle != null)
                    {
                        startTime = activeSubtitle.StartTime;
                        endTime = activeSubtitle.EndTime;
                        _logger.LogInformation("Auto-selected subtitle item: {Subtitle} (Start={StartTime}ms, End={EndTime}ms)",
                            activeSubtitle.ToString(), startTime, endTime);
                    }

                    gifCreatorRef.SetSubtitleTimes(startTime, endTime);
                    }
                }

                successMessage = $"Successfully auto-detected: {currentlyPlaying.EpisodeTitle ?? "media"}";
                _logger.LogInformation("Successfully prefilled form with currently playing media.");
            }
            catch (UnauthorizedAccessException ex)
            {
                errorMessage = ex.Message;
                _logger.LogWarning("Unauthorized access when detecting currently playing media.");
            }
            catch (Exception ex)
            {
                _logger.LogError(ex, "Error auto-detecting currently playing media");
                errorMessage = "An error occurred while detecting currently playing media. Please try again.";
            }
            finally
            {
                isAutoDetecting = false;
                StateHasChanged();
            }
        }
}